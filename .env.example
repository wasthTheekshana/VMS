POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://vms:change-me-local-only@localhost:5432/vms
REDIS_URL=redis://localhost:6380
# >= 32 random chars, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Idle session length (NFR-3)
JWT_EXPIRES_IN=30m
# 32-byte key, base64 (`openssl rand -base64 32`) - encrypts NIC/licence at rest (NFR-4)
DATA_ENCRYPTION_KEY=
# 32+ random chars - HMAC key for NIC lookup hashes
NIC_HASH_KEY=
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Seed super admin (first run only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Notifications. Until these are set, SMS/email are logged (masked) instead of sent.
OVERSTAY_CUTOFF=20:00
NOTIFY_BACKOFF_MS=5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vms@example.com

# Data retention in days for finished visits (default 3 years, minimum 30)
RETENTION_DAYS=1095

# ---------------------------------------------------------------------------------------------------------
# Production server only (~/vms-stack/.env). Generate EVERY secret fresh; never reuse the dev values.
# Use hex for passwords so they are safe inside connection URLs:  openssl rand -hex 24
#   POSTGRES_PASSWORD=<openssl rand -hex 24>
#   REDIS_PASSWORD=<openssl rand -hex 24>
#   JWT_SECRET=<openssl rand -base64 48>
#   DATA_ENCRYPTION_KEY=<openssl rand -base64 32>      (losing this key makes stored NICs unreadable: back it up safely)
#   NIC_HASH_KEY=<openssl rand -hex 32>                 (changing it breaks NIC lookup and the watch list)
#   VMS_DOMAIN=vms.testsys.shop
#   DATA_ROOT=/mnt/disks/data
# The compose file sets NODE_ENV, COOKIE_SECURE, TRUST_PROXY_HOPS, DATABASE_URL and REDIS_URL itself.
# ---------------------------------------------------------------------------------------------------------
